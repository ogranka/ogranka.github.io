---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  kind: string;
  title: string;
  description: string;
  preview?: ImageMetadata;
  previewAlt?: string;
  size?: 'wide' | 'half' | 'third';
  index?: number;
}

const { href, kind, title, description, preview, previewAlt = '', size = 'third', index = 0 } = Astro.props;
---

<a class:list={['case-card', size]} href={href} data-reveal style={`--i:${index}`}>
  <span class="preview">
    {
      preview ? (
        <Image src={preview} alt={previewAlt} widths={[480, 760, 1100]} sizes="(max-width: 760px) 92vw, 720px" loading={index === 0 ? 'eager' : 'lazy'} />
      ) : (
        <span class="placeholder" aria-hidden="true" />
      )
    }
  </span>
  <span class="body">
    <span class="kind">{kind}</span>
    <b>{title}</b>
    <p>{description}</p>
  </span>
</a>
