---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="cta-box wrap">
  <div class="box">
    <b>{title}</b>
    <p>{text}</p>
    <p class="how">Напишите в чате на Профи.ру, что за проект и к какому сроку. В ответ пришлю смету по пунктам.</p>
  </div>
</section>
