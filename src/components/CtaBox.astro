---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="cta-box wrap">
  <div class="box">
    <b>{title}</b>
    <p>{text}</p>
    <p class="how">Написать можно в чате на Профи.ру, где опубликовано это портфолио, или на почту ниже.</p>
  </div>
</section>
