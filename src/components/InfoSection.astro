---
import '../styles/components/_info-section.scss';
interface Item {
  title: string;
  text: string;
}

interface Props {
  heading: string;
  items: Item[];
}

const { heading, items } = Astro.props;
---

<section class:list={['info-section', 'wrap', { 'info-section--five': items.length === 5 }]}>
  <h2>{heading}</h2>
  <div class="grid">
    {
      items.map((item, index) => (
        <div class="card" data-reveal style={`--i:${index % 3}`}>
          <b>{item.title}</b>
          <p>{item.text}</p>
        </div>
      ))
    }
  </div>
</section>
