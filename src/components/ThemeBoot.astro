---
// Тема ставится до первой отрисовки, чтобы страница не мигала светлой при
// выбранной тёмной. Общий для хаба и журнала: оба читают один ключ theme.
---

<script is:inline>
  document.documentElement.classList.add('js');
  try {
    var t = localStorage.getItem('theme');
    if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
  } catch (e) {}
</script>
