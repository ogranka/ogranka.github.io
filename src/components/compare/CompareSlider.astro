---
import '../../styles/components/_compare-slider.scss';
import Chevrons from '../../assets/icons/chevrons.svg';
---

<div class="compare" data-compare>
  <span class="tag b">Было</span>
  <span class="tag a">Стало</span>

  <!-- «Стало» — нижний слой, «Было» — верхний, обрезается шторкой -->
  <!-- Демо-сайты внутри шторки только для показа: ссылки в них не должны ловить фокус -->
  <div class="pane after" inert><slot name="after" /></div>
  <div class="pane before" inert><slot name="before" /></div>

  <div class="divider">
    <button
      class="knob"
      data-knob
      role="slider"
      aria-label="Шторка сравнения: влево — было, вправо — стало"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="44"
    >
      <Chevrons />
    </button>
  </div>
</div>

<script>
  import { initCompareSliders } from '../../scripts/compare-slider';

  initCompareSliders();
</script>
