---
interface Props {
  href?: string;
  tone?: 'ink' | 'light';
  class?: string;
}

const { href = '#home', tone = 'ink', class: className = '' } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, className]} href={href} aria-label="Пион и мята, на главную">
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="10.5" r="5.2" />
    <circle cx="10.2" cy="14.6" r="5.2" />
    <circle cx="21.8" cy="14.6" r="5.2" />
    <circle cx="12.3" cy="21.2" r="5.2" />
    <circle cx="19.7" cy="21.2" r="5.2" />
    <circle class="core" cx="16" cy="16.4" r="3.1" />
    <path class="leaf" d="M16 24.5c3.4.2 5.6 2.2 6.3 5.2-3.2.1-5.5-1.7-6.3-5.2Z" />
  </svg>
  <span>Пион и&nbsp;мята</span>
</a>
