---
import DemoSite from './DemoSite.astro';

interface Props {
  variant: 'heavy' | 'light';
  title: string;
  subtitle: string;
  ariaLabel: string;
}

const { variant, title, subtitle, ariaLabel } = Astro.props;
---

<section class:list={['lane', variant]} data-lane={variant} aria-label={ariaLabel}>
  <div class="lane-head"><b>{title}</b><span>{subtitle}</span></div>
  <div class="stats">
    <div class="stat"><b data-stat="mb">0,0 МБ</b><span>загружено</span></div>
    <div class="stat"><b data-stat="rq">0</b><span>запросов</span></div>
    <div class="stat"><b data-stat="time">0.0 с</b><span>время</span></div>
  </div>
  <div class="status" data-status>Ожидание старта</div>
  <div class="screen">
    <div class="blank" data-blank>пустой экран</div>
    <DemoSite variant={variant} />
  </div>
</section>
