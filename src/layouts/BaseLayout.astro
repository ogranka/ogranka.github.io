---
const GOLOS_FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;800&family=PT+Serif:ital@1&display=swap';

interface Props {
  title: string;
  fontsHref?: string;
  noindex?: boolean;
}

const { title, fontsHref = GOLOS_FONTS_HREF, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontsHref} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
