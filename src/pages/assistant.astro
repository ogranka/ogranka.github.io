---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import NextCase from '../components/NextCase.astro';
import PhoneSingle from '../components/cvety/PhoneSingle.astro';
import '../styles/pages/assistant.scss';

const how = [
  {
    title: 'База знаний из каталога и правил магазина',
    text: 'Консультант знает 16 букетов с ценами и составом, условия доставки, слоты, открытки, самовывоз и политику замены цветов. Отвечает только по этой базе, а о том, чего в ней нет, так и говорит.',
  },
  {
    title: 'Прокси на своём сервере, ключ не в браузере',
    text: 'Сайт обращается к маленькому серверу на нашей стороне, а уже он к нейросети. Ключ доступа хранится на сервере в файле с ограниченными правами, в коде страницы его нет, перехватить из браузера нельзя.',
  },
  {
    title: 'Лимиты и стоимость диалога',
    text: 'Не больше 20 вопросов в час с одного адреса и 300 в сутки на всех, ответ не длиннее абзаца, ожидание не больше 30 секунд. База знаний кэшируется, поэтому один ответ обходится примерно в 20–40 копеек, диалог из пяти вопросов в один-два рубля.',
  },
  {
    title: 'Передача живому человеку',
    text: 'Жалоба, свой состав, другой город или оптовый заказ: консультант предлагает позвать флориста. Кнопка в чате открывает мессенджер и телефон магазина, история вопроса остаётся на экране.',
  },
  {
    title: 'Что меняется с CRM и остатками',
    text: 'Сейчас база знаний это текст, который обновляется вручную. При подключении к учёту консультант берёт наличие, цены и слоты доставки из системы, а готовый заказ создаёт в CRM, не заставляя покупателя заполнять форму.',
  },
];
---

<BaseLayout
  title="ИИ-консультант в интернет-магазине: отвечает по каталогу и передаёт флористу"
  description="Кейс ИИ-консультанта для магазина букетов: чат на сайте отвечает по каталогу и правилам доставки, не выдумывает товары, ведёт к корзине и передаёт сложные вопросы флористу. Живое демо внутри."
  caseNav
>
  <main>
    <PageHeader kind="ИИ-консультант">
      <Fragment slot="title">Консультант в чате магазина, который знает каталог и не выдумывает</Fragment>
      <Fragment slot="lede">
        Чат на витрине магазина букетов: отвечает про цены, состав и доставку по базе знаний магазина,
        ведёт к корзине, а нестандартные просьбы отдаёт флористу. Ниже рабочая версия: спросите что
        угодно про букеты и доставку.
      </Fragment>
    </PageHeader>

    <div class="wrap demo">
      <PhoneSingle src="/cvety/shop/?s=product&chat=1&example=1" title="Магазин букетов с открытым чатом консультанта" caption="Магазин «Пион и мята», карточка букета и чат" />
      <aside class="scenario" data-reveal>
        <b>Попробуйте сценарий</b>
        <ol>
          <li>Спросите: «Доставите сегодня к 18:00?» Консультант назовёт интервалы и доплату за точное время.</li>
          <li>Уточните цену: «Сколько стоят белые тюльпаны?» Ответ строго по каталогу, с предложением нажать «В корзину».</li>
          <li>Задайте вопрос не по теме или попросите букет из орхидей: консультант скажет, чего в магазине нет, и предложит позвать флориста.</li>
        </ol>
        <p class="scenario__note">Ответы приходят по буквам с нашего сервера. История чата живёт в этой вкладке и не отправляется никуда, кроме сервера консультанта. На демо действуют лимиты: 20 вопросов в час с одного адреса.</p>
      </aside>
    </div>

    <CaseSpec
      task="Магазин с доставкой за два часа получает одни и те же вопросы в мессенджер: привезёте ли сегодня, что в составе, сколько стоит к точному времени. Флорист отвечает между заказами, часть покупателей не дожидается ответа и уходит."
      solution="Поставил в витрину чат с консультантом на нейросети: база знаний собрана из каталога и правил магазина, ответы идут потоком через наш сервер, ключ доступа и лимиты живут на сервере. Консультант ведёт к корзине и оформлению, а всё, что не умеет, передаёт флористу одной кнопкой."
      result={[
        'Ответы на типовые вопросы круглосуточно, за секунды, по каталогу магазина',
        'Консультант не выдумывает товары и цены и не обещает того, чего нет в правилах',
        'Сложные случаи уходят живому флористу с сохранённой историей вопроса',
        'Стоимость каждого диалога известна заранее, лимиты защищают бюджет',
      ]}
      stack={['Виджет: TypeScript без библиотек, до 15 КБ', 'Прокси: Node, SSE-стриминг', 'Модель нейросети через официальный SDK', 'Кэширование базы знаний', 'Docker, Caddy, свой VPS']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужен консультант на вашем сайте?"
      text="Соберу базу знаний из вашего каталога и правил, поставлю чат на сайт и сервер с лимитами. Ответы только по вашим данным, передача менеджеру одной кнопкой. Смета по разделам, оплата по этапам после приёмки."
    />
    <NextCase current="/assistant/" />
  </main>
</BaseLayout>
