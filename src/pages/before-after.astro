---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import NextCase from '../components/NextCase.astro';
import BrowserFrame from '../components/compare/BrowserFrame.astro';
import CompareSlider from '../components/compare/CompareSlider.astro';
import SiteBefore from '../components/compare/SiteBefore.astro';
import SiteAfter from '../components/compare/SiteAfter.astro';
import ArrowsOut from '../assets/icons/arrows-out.svg';
import '../styles/pages/before-after.scss';

const changes = [
  {
    title: 'Цены на виду',
    text: '«Договорная» читается как «дорого и по настроению». Конкретная цифра снимает страх звонка.',
  },
  {
    title: 'Одна кнопка записи',
    text: 'Было меню из шести пунктов и гостевая книга. Стало одна кнопка «Записаться», к которой ведёт вся страница.',
  },
  {
    title: 'Главное крупно',
    text: 'Бегущая строка и мигающий текст требуют внимания, но не отвечают ни на один вопрос пациента. Теперь главное крупно, второстепенное тише.',
  },
  {
    title: 'Доверие деталями',
    text: 'Отзыв, лицензия, часы работы и адрес: всё это пациент может проверить сам.',
  },
  {
    title: 'Адаптив',
    text: 'Старая версия на телефоне требует лупы. Новая перестраивается: сузьте окно браузера и подвигайте шторку ещё раз.',
  },
  {
    title: 'Скорость',
    text: 'Обе панели на этой странице чистый HTML и CSS, без единой библиотеки. Страница целиком легче одной фотографии со старого сайта.',
  },
];
---

<BaseLayout
  title="Сайт клиники: было и стало"
  description="Переработка сайта стоматологии: тот же контент, другая подача. Старая и новая версии под одной интерактивной шторкой."
  caseNav
>
  <main>
    <PageHeader kind="Переработка сайта">
      <Fragment slot="title">Тот же сайт, та же информация, другое впечатление</Fragment>
      <Fragment slot="lede">
        Слева сайт, каким он встретил 2012 год и в котором живёт до сих пор. Справа он же после
        переработки: контент не изменился, изменилась подача.
      </Fragment>
      <div class="hint">
        <ArrowsOut />
        Двигайте шторку мышью, пальцем или стрелками
      </div>
    </PageHeader>

    <div class="wrap">
      <BrowserFrame url="denta-lux-clinic.ru, вымышленная клиника">
        <CompareSlider>
          <SiteBefore slot="before" />
          <SiteAfter slot="after" />
        </CompareSlider>
      </BrowserFrame>
      <p class="after-note">
        «Дента-Люкс» вымышленная клиника. Оба варианта сверстаны с нуля для этой демонстрации;
        совпадения с реальными сайтами свойство эпохи, а не цитата.
      </p>
    </div>

    <CaseSpec
      task="У клиники сайт десятилетней давности: бегущая строка, шесть пунктов меню, «цена договорная». Пациенты открывают его с телефона и уходят звонить конкурентам."
      solution="Оставил контент и структуру, переработал подачу: одна цель на странице, цены на виду, доверие через факты. Сверстал новую версию заново, без конструктора и библиотек."
      result={[
        'Страница ведёт к одному действию: записаться',
        'Читается с телефона без лупы',
        'Весит меньше одной старой фотографии',
        'Старый сайт работает, пока новая версия не принята',
      ]}
      stack={['HTML и CSS', 'TypeScript для шторки', 'Astro для сборки']}
    />

    <InfoSection heading="Что именно изменилось" items={changes} />

    <CtaBox
      title="У вашего сайта тоже есть «было»?"
      text="Переработка не означает «всё выбросить». Контент, структура и то, что уже работает, остаются. Меняется подача, скорость и путь посетителя до заявки."
    />
    <NextCase current="/before-after/" />
  </main>
</BaseLayout>
