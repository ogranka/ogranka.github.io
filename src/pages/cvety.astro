---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import PhoneStrip from '../components/cvety/PhoneStrip.astro';
import '../styles/pages/cvety.scss';

const screens = [
  { id: 'home', label: 'Главная', title: 'Главная магазина: слайдер, промокод, разделы' },
  { id: 'catalog', label: 'Каталог', title: 'Каталог: фильтр-шторка и сортировка' },
  { id: 'product', label: 'Букет', title: 'Карточка букета: галерея, открытка, лента' },
  { id: 'checkout', label: 'Заказ', title: 'Оформление заказа в четыре шага' },
];

const how = [
  {
    title: 'Оформление в четыре шага',
    text: 'Получатель и адрес, день и интервал, открытка, оплата. Каждый шаг проверяет свои поля и подсказывает, что поправить, а итог считается с доставкой и доплатой за точное время.',
  },
  {
    title: 'Фильтр-шторка',
    text: 'Фильтр выезжает снизу, как на телефоне: кнопка «Показать» сразу считает, сколько букетов подходит. Сортировка перестраивает настоящую сетку, а не рисует заново.',
  },
  {
    title: 'Сборка букета',
    text: 'Открытка с текстом и лента из восьми цветов выбираются в карточке и переносятся в заказ. Выбор виден на плитке до оформления.',
  },
  {
    title: 'Скорость',
    text: 'Фото пережаты в WebP и грузятся по мере прокрутки, шрифты лежат на сайте, без библиотек. Экран открывается быстрее, чем успеваешь поднять палец.',
  },
  {
    title: 'Адаптив',
    text: 'Витрина собрана под ширину от 320 до 430 пикселей: безопасные зоны, плавающий блок действий вместо бургера, клавиатура не закрывает поля.',
  },
];
---

<BaseLayout
  title="Магазин букетов с доставкой: мобильная витрина и оформление заказа"
  description="Кейс интернет-магазина букетов: каталог с фильтром-шторкой, сборка букета, корзина и оформление заказа в четыре шага. Живая версия внутри страницы."
  caseNav
>
  <main>
    <PageHeader kind="Интернет-магазин">
      <Fragment slot="title">Магазин букетов, в котором заказ оформляется за четыре шага</Fragment>
      <Fragment slot="lede">
        Мобильная витрина для цветочного магазина с доставкой: слайдер подборок, каталог с
        фильтром, карточка с настройкой букета и оформление заказа. Все экраны ниже живые: листайте,
        нажимайте, добавляйте в корзину.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <PhoneStrip base="/cvety/shop/" screens={screens} />
      <p class="note">«Пион и мята» — вымышленный магазин, цены и названия придуманы для показа. Фото с Unsplash.</p>
    </div>

    <CaseSpec
      task="Магазину с доставкой нужна мобильная версия, в которой покупают, а не рассматривают: 85% визитов с телефона, а старый сайт требовал лупы и семи экранов до оплаты."
      solution="Собрал витрину как приложение: полноэкранные подборки, фильтр и сортировка в шторках, настройка букета прямо в карточке, плавающий блок действий вместо меню и оформление заказа в четыре коротких шага с проверкой полей."
      result={[
        'Путь от каталога до оплаты за четыре экрана, без регистрации',
        'Фильтр, сортировка, корзина и избранное работают без перезагрузки',
        'Открытка и лента продаются в карточке, а не теряются в комментарии к заказу',
        'Витрина переносится на любую платформу: WordPress и WooCommerce, Tilda, своя сборка',
      ]}
      stack={['HTML и CSS без фреймворков', 'TypeScript', 'Astro для сборки', 'Фото WebP', 'Шрифты Onest и Oswald']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужен магазин или витрина для телефона?"
      text="Соберу такую же под ваш товар: каталог, корзина, оплата и доставка. Смета по разделам, оплата по этапам после приёмки, тестовая копия до запуска."
    />
  </main>
</BaseLayout>
