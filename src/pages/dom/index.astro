---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseSpec from '../../components/CaseSpec.astro';
import InfoSection from '../../components/InfoSection.astro';
import CtaBox from '../../components/CtaBox.astro';
import NextCase from '../../components/NextCase.astro';
import '../../styles/pages/dom-case.scss';

const how = [
  {
    title: 'Дом собирается по прокрутке',
    text: 'При открытии чертёж вычерчивается сам, а прокрутка достраивает дом: фундамент, стены, крыша, свет в окнах. Первый экран закреплён ровно на это время, дальше страница идёт обычной прокруткой.',
  },
  {
    title: 'Квиз считает по формуле, а не наугад',
    text: 'Площадь, этажность, фундамент, комплектация и срок дают диапазон цены и срок стройки. Цена «от» у проектов посчитана той же формулой, поэтому цифры на странице сходятся между собой.',
  },
  {
    title: 'Форма, которая не теряет заявки',
    text: 'Телефон форматируется по мере ввода, ошибка показывается рядом с полем и объясняет, что исправить. Согласие на обработку данных по 152-ФЗ обязательно и проверяется до отправки.',
  },
  {
    title: 'Работает без анимации',
    text: 'Если в системе отключено движение или скрипт не загрузился, виден готовый дом и все блоки. Проекты листаются пальцем, мышью, кнопками и с клавиатуры.',
  },
  {
    title: 'Быстрый, несмотря на движение',
    text: 'Анимации на GSAP подключены только на этой странице, фото пережаты под размер экрана, шрифты лежат рядом с сайтом. Страница не прыгает при загрузке.',
  },
];
---

<BaseLayout
  title="Лендинг строительной компании: дом собирается по прокрутке, квиз расчёта стоимости"
  description="Кейс продающего лендинга мастерской каркасных домов: первый экран, где чертёж собирается в дом по прокрутке, проекты, этапы, состав цены и квиз расчёта стоимости с заявкой."
  caseNav
>
  <main>
    <PageHeader kind="Лендинг">
      <Fragment slot="title">Лендинг, на котором дом строится, пока его листают</Fragment>
      <Fragment slot="lede">
        Продающая страница мастерской каркасных домов: чертёж на первом экране собирается в дом по
        прокрутке, дальше проекты с ценами, этапы стройки, состав цены и квиз, который считает стоимость
        и собирает заявку. Ниже рабочая версия: листайте и посчитайте свой дом.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <div class="demo-frame">
        <iframe src="/dom/site/?autoplay=1" title="Лендинг мастерской каркасных домов, рабочая версия" loading="lazy"></iframe>
      </div>
      <p class="demo-open">
        Открыть отдельно: <a href="/dom/site/" target="_blank" rel="noopener">лендинг во весь экран</a>. Мастерская, проекты и цены
        вымышленные, фото с Unsplash.
      </p>
    </div>

    <CaseSpec
      task="Строительной компании нужен лендинг, который отличает её от сотни похожих сайтов с фотографией дома и формой «оставьте телефон». Человек должен за пару минут понять, что входит в цену и сколько будет стоить его дом, и оставить заявку уже с расчётом."
      solution="Собрал одну длинную страницу вокруг идеи «сначала рисуем, потом строим»: первый экран с чертежом, который собирается в дом по прокрутке, проекты с ценой «от», шесть этапов с линией прогресса, честный состав цены и квиз из пяти шагов с итогом и формой телефона."
      result={[
        'Первый экран, который запоминают и досматривают до конца',
        'Заявки приходят уже с площадью, комплектацией и примерной ценой',
        'Цены на странице сходятся между собой: проекты и квиз считаются одной формулой',
        'В рабочей версии заявка уходит в Telegram или CRM, подключаются Метрика и цели по шагам квиза',
      ]}
      stack={['Astro', 'GSAP и ScrollTrigger', 'TypeScript', 'SCSS', 'SVG-анимация', 'Шрифты Jost и Manrope']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужен лендинг, который продаёт, а не просто красиво выглядит?"
      text="Соберу страницу под ваш продукт: первый экран с характером, понятная цена, квиз или калькулятор и форма заявки, которая уходит в Telegram или CRM. Смета по разделам, оплата по этапам после приёмки."
    />
    <NextCase current="/dom/" />
  </main>
</BaseLayout>
