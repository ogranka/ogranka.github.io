---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import '../styles/pages/forum-hero-case.scss';

const details = [
  {
    title: 'Частицы на canvas',
    text: 'Рельеф из точек рисуется на canvas и реагирует на курсор. Никаких библиотек: 17 КБ кода, 60 кадров в секунду на обычном ноутбуке.',
  },
  {
    title: 'Появление по очереди',
    text: 'Заголовок, подзаголовок, цифры и кнопки выходят с задержкой в сотню миллисекунд друг за другом. Одна оркестрованная сцена вместо случайных эффектов.',
  },
  {
    title: 'Цифры набираются в кадре',
    text: 'Счётчики участников и компаний стартуют, когда блок попадает в экран. Это IntersectionObserver, он есть в каждом браузере.',
  },
  {
    title: 'Бережно к слабым устройствам',
    text: 'При системной настройке «меньше движения» анимации выключаются, страница остаётся читаемой и быстрой.',
  },
];
---

<BaseLayout
  title="Сайт отраслевого форума: оживший первый экран"
  description="Концепт первого экрана сайта отраслевого форума: анимация частиц на canvas, появление блоков и счётчики без библиотек, 17 КБ кода."
  caseNav
>
  <main>
    <PageHeader kind="Первый экран сайта">
      <Fragment slot="title">Первый экран, который выглядит как дорогой студийный сайт</Fragment>
      <Fragment slot="lede">
        Концепт главной страницы отраслевого форума: рельеф из частиц, появление блоков, счётчики.
        Всё это 17 КБ кода без единой библиотеки. Ниже живая версия, подвигайте курсором по фону.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <div class="demo-frame">
        <iframe src="/forum-hero/demo/" title="Концепт главной страницы форума" loading="lazy"></iframe>
      </div>
      <p class="demo-open">
        <a href="/forum-hero/demo/" target="_blank" rel="noopener">Открыть концепт на весь экран</a>
      </p>
    </div>

    <CaseSpec
      task="Организатору форума нужен первый экран, после которого не стыдно слать ссылку партнёрам: «как у дорогих студий», но без их бюджета и без тяжёлых библиотек, которые тянут сайт вниз."
      solution="Нарисовал сцену на canvas и собрал анимации на стандартных средствах браузера: появление блоков, счётчики, реакция карточек на курсор. Без WebGL-движков и без jQuery."
      result={[
        'Первый экран уровня студийного сайта за два дня работы',
        'Страница весит меньше одной фотографии',
        'Анимации уважают настройку «меньше движения»',
        'Концепт легко переносится на реальный сайт форума',
      ]}
      stack={['Canvas 2D', 'IntersectionObserver', 'TypeScript', 'SCSS', 'Astro для сборки']}
    />

    <InfoSection heading="Как устроено" items={details} />

    <CtaBox
      title="Хотите такой же первый экран?"
      text="Соберу под ваш сайт: мероприятие, компания, продукт. Сначала концепт одного экрана, чтобы увидеть результат до оплаты всего проекта."
    />
  </main>
</BaseLayout>
