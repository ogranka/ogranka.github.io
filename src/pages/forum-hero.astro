---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import NextCase from '../components/NextCase.astro';
import '../styles/pages/forum-hero-case.scss';

const details = [
  {
    title: 'Рельеф из частиц',
    text: 'Рельеф из точек рисуется прямо в браузере и реагирует на курсор. Сторонних библиотек нет: 17 КБ кода, плавно даже на обычном ноутбуке.',
  },
  {
    title: 'Появление по очереди',
    text: 'Заголовок, подзаголовок, цифры и кнопки выходят с задержкой в сотню миллисекунд друг за другом. Эффекты складываются в одну сцену и не спорят друг с другом.',
  },
  {
    title: 'Цифры набираются в кадре',
    text: 'Счётчики участников и компаний стартуют, когда блок попадает в экран, поэтому посетитель видит, как набираются цифры.',
  },
  {
    title: 'Бережно к слабым устройствам',
    text: 'При системной настройке «меньше движения» анимации выключаются, страница остаётся читаемой и быстрой.',
  },
];
---

<BaseLayout
  title="Сайт отраслевого форума: оживший первый экран"
  description="Концепт первого экрана сайта отраслевого форума: анимация частиц на canvas, появление блоков и счётчики без библиотек, 17 КБ кода."
  caseNav
>
  <main>
    <PageHeader kind="Первый экран сайта">
      <Fragment slot="title">Первый экран, который выглядит как дорогой студийный сайт</Fragment>
      <Fragment slot="lede">
        Концепт главной страницы отраслевого форума: рельеф из частиц, появление блоков, счётчики.
        Всё это 17 КБ кода без сторонних библиотек. Ниже рабочая версия, подвигайте курсором по фону.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <div class="demo-frame">
        <iframe src="/forum-hero/demo/" title="Концепт главной страницы форума" loading="lazy"></iframe>
      </div>
      <p class="demo-open">
        <a href="/forum-hero/demo/" target="_blank" rel="noopener">Открыть концепт на весь экран</a>
      </p>
    </div>

    <CaseSpec
      task="Концепт для организатора отраслевого форума: первый экран, ссылку на который не стыдно отправить партнёрам. Уровень дорогой студии, но без её бюджета и без тяжёлых библиотек, которые тормозят сайт."
      solution="Нарисовал рельеф из точек и собрал анимации на встроенных средствах браузера: появление блоков, счётчики, реакция карточек на курсор. Сторонних библиотек нет."
      result={[
        'Концепт первого экрана за два дня работы',
        'Страница весит меньше одной фотографии',
        'Анимации уважают настройку «меньше движения»',
        'Экран переносится на рабочий сайт без переделки',
      ]}
      stack={['Canvas 2D', 'IntersectionObserver', 'TypeScript', 'SCSS', 'Astro для сборки']}
    />

    <InfoSection heading="Как устроено" items={details} />

    <CtaBox
      title="Хотите такой же первый экран?"
      text="Соберу под ваш сайт: мероприятие, компания, продукт. Сначала концепт одного экрана, чтобы увидеть результат до оплаты всего проекта."
    />
    <NextCase current="/forum-hero/" />
  </main>
</BaseLayout>
