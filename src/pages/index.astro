---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
import { cases } from '../data/cases';
import '../styles/pages/index.scss';

const previews = import.meta.glob<{ default: ImageMetadata }>('../assets/previews/*.webp', { eager: true });
const preview = (name: string) => previews[`../assets/previews/${name}.webp`]?.default;

// Коллаж первого экрана: четыре кейса разного типа, каждое превью ведёт на кейс
const collage = ['/cvety/', '/zhurnal/', '/forum-hero/', '/dom/'].map((href) => cases.find((c) => c.href === href)!);

// Колонка карточки в ряду сетки для задержки выезда: широкая занимает ряд
// целиком, половинки идут парами
let column = 0;
const cards = cases.map((item) => {
  const col = item.size === 'wide' ? 0 : column;
  column = item.size === 'wide' ? 0 : (column + 1) % 2;
  return { ...item, col };
});

// Полоса цифр под первым экраном. Значения стоят в разметке итоговыми,
// скрипт только отсчитывает их от нуля, когда полоса показалась
const stats = [
  { value: cases.length, label: 'кейсов с рабочими версиями внутри' },
  { value: 100, label: 'баллов из 100 в проверке скорости Google' },
  { value: 30, label: 'дней гарантии после запуска' },
];

const includes = [
  { title: 'Дизайн и сборка у одного человека', text: 'Макет согласуем до кода, второго подрядчика искать не нужно.' },
  { title: 'Интеграции', text: 'Оплата картой и СБП, доставка, CRM, заявки в Telegram, внешние сервисы.' },
  { title: 'Админка', text: 'Тексты, товары и цены меняете сами, без программиста.' },
  { title: 'Скорость и телефон', text: 'Быстрая загрузка, версия для телефона, базовая SEO-подготовка, согласие на обработку данных по 152-ФЗ.' },
];

const afterLaunch = [
  { title: 'Гарантия 30 дней после запуска', text: 'Если что-то работает не так, как договорились, исправлю бесплатно и быстро.' },
  { title: 'Передаю все доступы', text: 'И короткую инструкцию к админке, чтобы менять сайт без меня.' },
  { title: 'Сопровождение по желанию', text: 'Правки, обновления и новые разделы, когда они понадобятся.' },
];

// Разметка для поисковиков: кто делает и что, без фамилии и контактов
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'ogranka. Сайты и веб-сервисы под ключ',
  url: 'https://ogranka.github.io/',
  image: 'https://ogranka.github.io/og/home.jpg',
  areaServed: 'RU',
  knowsLanguage: 'ru',
  description: 'Интернет-магазины, сайты компаний, лендинги, личные кабинеты, Telegram-боты и ИИ-ассистенты. От сметы до запуска одним исполнителем.',
};

const steps = [
  {
    title: 'Смета по пунктам',
    text: 'Разбираю задачу на разделы и называю цену и срок каждого. Видно, что входит и за что платите. По ходу работы цена не растёт.',
  },
  {
    title: 'Этапы с оплатой после приёмки',
    text: 'Каждый этап показываю, вы проверяете, потом оплата. Аванс только за первый этап.',
  },
  {
    title: 'Тестовая копия',
    text: 'Работа идёт на тестовом адресе. Рабочий сайт не трогаю, пока новая версия не принята.',
  },
  {
    title: 'Срок в днях',
    text: 'Называю реальные дни, а не «около трёх недель». Если срок сдвигается, предупреждаю заранее. Работаю по договору, чек самозанятого.',
  },
];
---

<BaseLayout
  jsonLd={jsonLd}
  title="Сайты и веб-сервисы под ключ. ogranka"
  description="Интернет-магазины, лендинги и личные кабинеты под ключ: смета по пунктам, этапы с оплатой после приёмки, срок в днях. Живые кейсы, которые можно потрогать."
>
  <main>
    <section class="hero wrap">
      <div class="hero__text">
        <h1>Сайты и <span class="nowrap">веб-сервисы</span> под&nbsp;ключ</h1>
        <p class="lede">
          Интернет-магазины, сайты компаний, лендинги, личные кабинеты, <span class="nowrap">Telegram-боты</span> и
          ИИ-ассистенты. От сметы до запуска одним исполнителем.
        </p>
        <p class="trust">
          Больше восьми лет в коммерческой разработке, последние годы в команде крупного сервиса,
          детали под NDA. Держу немного проектов одновременно и отвечаю в тот же день.
        </p>
        <div class="hero__actions">
          <a class="btn btn--ink pressable" href="#cases">Смотреть кейсы</a>
          <a class="btn btn--line pressable" href="#contact">Как заказать</a>
        </div>
      </div>
      <div class="collage" aria-label="Четыре кейса">
        {
          collage.map((item, i) => (
            <a class={`collage__item collage__item--${i + 1} pressable`} href={item.href} aria-label={`Кейс: ${item.title}`}>
              <span class="collage__chrome" aria-hidden="true"><i></i><i></i><i></i></span>
              <Image src={preview(item.preview)!} alt="" widths={[360, 560, 760]} sizes="380px" loading="lazy" decoding="async" />
            </a>
          ))
        }
      </div>
    </section>

    <section class="stats wrap" aria-label="Коротко в цифрах">
      <ul>
        {
          stats.map((s) => (
            <li>
              <b>
                <span class="visually-hidden">{s.value}</span>
                <span class="stats__num" aria-hidden="true" data-count={s.value} style={`--digits:${String(s.value).length}`}>
                  {s.value}
                </span>
              </b>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" id="cases" aria-labelledby="cases-h">
      <div class="cases-head">
        <h2 id="cases-h">Кейсы</h2>
        <p>Внутри каждого кейса задача, решение и рабочая версия, которую можно листать и нажимать.</p>
      </div>
      <div class="cases">
        {cards.map((item, index) => <CaseCard {...item} preview={preview(item.preview)} index={index} />)}
      </div>
    </section>

    <section class="includes wrap" aria-labelledby="includes-h">
      <h2 id="includes-h">Что входит в работу</h2>
      <ul>
        {
          includes.map((item) => (
            <li data-reveal>
              <b>{item.title}</b>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="process wrap" id="process" aria-labelledby="process-h">
      <h2 id="process-h">Как работаю</h2>
      <ol>
        {
          steps.map((step, index) => (
            <li data-reveal style={`--i:${index}`}>
              <span class="num" aria-hidden="true">{index + 1}</span>
              <b>{step.title}</b>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="after-launch wrap" aria-labelledby="after-h">
      <h2 id="after-h">После запуска</h2>
      <ul>
        {
          afterLaunch.map((item) => (
            <li data-reveal>
              <b>{item.title}</b>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="contact wrap" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Обсудить проект</h2>
      <p>
        Напишите в чате на Профи.ру: что за бизнес, какой сайт нужен и к какому сроку. Можно
        своими словами и со ссылкой на сайт, который нравится. В ответ пришлю смету по пунктам и срок в днях.
      </p>
    </section>
  </main>
</BaseLayout>
