---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseCard from '../components/CaseCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/pages/index.scss';

const services = [
  'доработка сайтов',
  'анимация и интерактив',
  'ускорение загрузки',
  'интеграции и формы',
  'сопровождение',
];

const cases = [
  {
    href: '/before-after/',
    kicker: 'Интерактивный кейс',
    title: 'Было → стало',
    description:
      'Сайт из 2012 года и его сегодняшняя версия под одной шторкой. Контент тот же — впечатление другое. Шесть конкретных причин, почему.',
    cta: 'Подвигать шторку',
  },
  {
    href: '/speed-race/',
    kicker: 'Интерактивный кейс',
    title: 'Гонка скорости',
    description:
      'Два одинаковых сайта грузятся наперегонки: сборка «всё включено» против аккуратной вёрстки. Живые счётчики мегабайт, запросов и секунд.',
    cta: 'Запустить гонку',
  },
  {
    href: '/forum-hero/',
    kicker: 'Концепт под задачу клиента',
    title: 'Оживший первый экран',
    description:
      'Анимация уровня «дорогой студийный сайт» без тяжёлых библиотек: рельеф из частиц на canvas, 17 КБ, 60+ кадров в секунду.',
    cta: 'Посмотреть',
  },
];
---

<BaseLayout title="Сергей Д. — оживляю, ускоряю и дорабатываю сайты">
  <PageHeader>
    <Fragment slot="title">
      Оживляю, ускоряю и дорабатываю сайты — <em>не&nbsp;ломая то, что&nbsp;работает.</em>
    </Fragment>
    <Fragment slot="lede">
      Сергей Д., разработчик. 8+ лет коммерческой разработки. Вместо списка технологий —
      интерактивные кейсы: каждый можно потрогать руками.
    </Fragment>
    <div class="services">
      {services.map((service) => <span>{service}</span>)}
    </div>
  </PageHeader>

  <main class="cases wrap">
    {cases.map((item) => <CaseCard {...item} />)}
  </main>

  <SiteFooter />
</BaseLayout>
