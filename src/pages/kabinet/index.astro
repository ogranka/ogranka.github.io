---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseSpec from '../../components/CaseSpec.astro';
import InfoSection from '../../components/InfoSection.astro';
import CtaBox from '../../components/CtaBox.astro';
import NextCase from '../../components/NextCase.astro';
import '../../styles/pages/kabinet-case.scss';

const how = [
  {
    title: 'Остаток занятий считается сам',
    text: 'Оплата пакета добавляет занятия, проведённое занятие и поздняя отмена списывают по одному. Ученик с последним занятием и ученик в долгу помечены в списке, их видно до того, как родитель спросит.',
  },
  {
    title: 'Правило отмены видно заранее',
    text: 'В окне отмены написано, сколько часов осталось до начала и спишется ли занятие. Срок бесплатной отмены задаётся в настройках, по умолчанию сутки. Спорить с родителями о списании не приходится.',
  },
  {
    title: 'Перенос без накладок',
    text: 'При выборе нового времени кабинет сразу проверяет расписание и показывает, с кем пересечение. Занятое время сохранить нельзя, перенесённое занятие помнит, откуда его перенесли.',
  },
  {
    title: 'У родителя свой кабинет',
    text: 'Родитель видит только своего ребёнка: ближайшие занятия, остаток абонемента и отчёты. Менять ничего не может, только попросить перенос, и запрос сразу появляется у преподавателя на первом экране.',
  },
  {
    title: 'Отчёт за месяц без ручной работы',
    text: 'Темы, заметки о прогрессе, переносы, отмены и оплаты собираются из отметок о занятиях. Отчёт сохраняется в PDF из браузера и выглядит как аккуратный лист, без кнопок и меню.',
  },
];
---

<BaseLayout
  title="Кабинет репетитора: расписание, абонементы, оплаты и отчёты родителям"
  description="Кейс веб-кабинета частного преподавателя: неделя занятий, ученики с остатком абонемента, оплаты, пробные уроки, отчёты родителям и отдельный вход для родителя. Рабочая версия внутри страницы."
  caseNav
>
  <main>
    <PageHeader kind="Личный кабинет">
      <Fragment slot="title">Кабинет репетитора, который сам считает занятия и деньги</Fragment>
      <Fragment slot="lede">
        Веб-кабинет частного преподавателя: неделя занятий, ученики, абонементы, оплаты, пробные уроки
        и отчёты родителям. Переключатель наверху показывает тот же кабинет глазами родителя. Ниже
        рабочая версия: отмечайте занятия, переносите, принимайте оплаты.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <div class="demo-frame">
        <iframe src="/kabinet/app/" title="Кабинет репетитора, рабочая версия" loading="lazy"></iframe>
      </div>
      <p class="demo-open">
        Открыть отдельно: <a href="/kabinet/app/" target="_blank" rel="noopener">кабинет преподавателя</a>,{' '}
        <a href="/kabinet/app/?role=parent" target="_blank" rel="noopener">кабинет родителя</a>. Преподаватель, ученики и
        родители вымышленные, данные хранятся только в вашем браузере.
      </p>
    </div>

    <CaseSpec
      task="Частный преподаватель ведёт полтора десятка учеников и держит всё в заметках, таблице и переписке с родителями. Остаток абонемента приходится пересчитывать вручную, переносы и отмены теряются, а в конце месяца уходит вечер на отчёты. Нужен один кабинет, где всё это считается само."
      solution="Собрал кабинет как одностраничное приложение: неделя занятий, карточки учеников, журнал оплат, заявки на пробные и отчёты. Правила списания, отмены и переносов заложены в логику и показаны прямо в окнах действий. Для родителя отдельный вид с его ребёнком и запросом переноса."
      result={[
        'Остаток занятий у каждого ученика верный в любой момент, без таблиц',
        'Поздняя отмена списывается по правилу, которое родитель видел заранее',
        'Перенос на занятое время невозможен, накладок в расписании нет',
        'Отчёт родителю за месяц собирается сам и сохраняется в PDF',
        'В рабочей версии подключаются база, вход по паролю, оплата через ЮKassa и напоминания в Telegram',
      ]}
      stack={['React', 'TypeScript', 'Astro', 'Имитация API с задержкой', 'Печать в PDF средствами браузера', 'Шрифт Golos Text']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужен личный кабинет для студии, школы или своей практики?"
      text="Соберу кабинет под ваши правила: расписание, абонементы, оплаты, отчёты и доступ для клиентов. Смета по разделам, оплата по этапам после приёмки."
    />
    <NextCase current="/kabinet/" />
  </main>
</BaseLayout>
