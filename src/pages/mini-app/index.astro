---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseSpec from '../../components/CaseSpec.astro';
import InfoSection from '../../components/InfoSection.astro';
import CtaBox from '../../components/CtaBox.astro';
import NextCase from '../../components/NextCase.astro';
import PhoneSingle from '../../components/cvety/PhoneSingle.astro';
import '../../styles/pages/mini-app-case.scss';

// Адрес бота в Telegram без @. Пока бот не создан, кнопка «Открыть в Telegram» не показывается
const bot = '';

const how = [
  {
    title: 'Выглядит как часть Telegram',
    text: 'Приложение берёт цвета из темы пользователя, поэтому в светлой, тёмной и любой своей теме смотрится родным. Нижняя кнопка и «назад» это кнопки самого Telegram, при выборе дня и времени телефон слегка вибрирует. Свой у барбершопа только знак в шапке.',
  },
  {
    title: 'Свободное время по правилам барбершопа',
    text: 'Сетка по 30 минут: стрижка с бородой на полтора часа занимает три окна подряд. У каждого мастера свой выходной, у топ-барбера цена на 400 ₽ выше, ближе чем за полчаса до начала записаться нельзя. «Любой мастер» показывает общее свободное время и отдаёт запись тому, у кого дешевле.',
  },
  {
    title: 'Одно время не займут дважды',
    text: 'Сервер проверяет слот и записывает его одним действием. Если два человека нажмут «Записаться» на одно время одновременно, второй увидит «это время уже заняли» и обновлённую сетку. Правила записи у телефона и сервера общие, из одного файла.',
  },
  {
    title: 'Подпись Telegram вместо пароля',
    text: 'Входа и пароля нет: Telegram подписывает данные пользователя ключом бота, сервер проверяет подпись у каждой записи и отмены. Подделанный или устаревший запрос отклоняется. Телефон и другие личные данные не собираются, имя берётся из Telegram.',
  },
  {
    title: 'Бот ведёт клиента после записи',
    text: 'Подтверждение с кнопкой отмены, напоминание о визите, исправленное сообщение после отмены. В демо напоминание приходит через минуту, в рабочей версии за два часа до визита, а администратор получает уведомление о каждой записи и отмене.',
  },
];
---

<BaseLayout
  title="Telegram Mini App для записи в барбершоп: услуга, мастер, время и напоминание"
  description="Кейс мини-приложения в Telegram: запись в барбершоп за минуту, свободное время по правилам мастеров, подтверждение, напоминание и отмена через бота. Рабочая версия внутри страницы."
  caseNav
>
  <main>
    <PageHeader kind="Telegram Mini App">
      <Fragment slot="title">Запись в барбершоп прямо в Telegram, без звонков и переписки</Fragment>
      <Fragment slot="lede">
        Мини-приложение открывается из чата с ботом: клиент выбирает услугу, мастера и время, а бот присылает
        подтверждение и напоминание. Ниже рабочая версия: запишитесь, и справа появится то, что пришло бы в
        чат с ботом.
      </Fragment>
    </PageHeader>

    <div class="wrap demo">
      <PhoneSingle src="/mini-app/app/" title="Мини-приложение записи в Барбершоп 313" caption="Барбершоп «313», запись внутри Telegram" />
      <aside class="side">
        <section class="chat" aria-label="Чат с ботом" data-chat>
          <header class="chat__head">
            <span class="chat__ava" aria-hidden="true">313</span>
            <span><b>Барбершоп 313</b><small>бот</small></span>
          </header>
          <ol class="chat__log" aria-live="polite" data-log>
            <li class="msg">
              <p>Барбершоп 313, запись онлайн. Выберите услугу, мастера и время, подтверждение и напоминание придут сюда.</p>
              <span class="msg__btns"><span class="msg__btn">Записаться</span></span>
            </li>
          </ol>
          <p class="chat__note">Так выглядит чат с ботом. Здесь он повторяет то, что бот прислал бы в Telegram.</p>
        </section>
        {
          bot && (
            <a class="tg-open pressable" href={`https://t.me/${bot}`} target="_blank" rel="noopener">
              Открыть в Telegram
            </a>
          )
        }
        <p class="demo-note">
          Мастера, цены и адрес вымышленные. Записи из этой страницы хранятся только в вашем браузере.
          {bot && ' В Telegram запись настоящая: бот пришлёт подтверждение и напоминание, а через сутки запись удалится сама.'}
        </p>
      </aside>
    </div>

    <CaseSpec
      task="Барбершоп записывает клиентов в мессенджере вручную: администратор отвечает на «есть время в субботу?», сверяется с расписанием мастеров и не всегда успевает напомнить о визите. Клиенты пропускают запись, окна простаивают, а звонить или заполнять форму на сайте многим неудобно."
      solution="Сделал запись прямо в Telegram: мини-приложение открывается из чата с ботом, берёт цвета темы пользователя и ведёт по шагам до подтверждения. Свободное время считается по правилам барбершопа, сервер проверяет подпись Telegram у каждой записи и не даёт занять одно время дважды, а бот присылает подтверждение, напоминание и принимает отмену."
      result={[
        'Запись за минуту, без звонка и переписки с администратором',
        'Клиент видит только действительно свободное время, накладок в расписании нет',
        'Подтверждение и напоминание приходят в Telegram сами, отмена одной кнопкой',
        'Подделать запись от чужого имени нельзя: сервер проверяет подпись Telegram',
        'В рабочей версии подключаются расписание из учётной системы или Google Таблицы, предоплата и уведомления администратору',
      ]}
      stack={['Telegram Mini Apps', 'TypeScript без библиотек', 'Бот: Node, Bot API', 'Проверка подписи initData', 'Docker, Caddy, свой VPS']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужна запись или заказ в Telegram?"
      text="Соберу мини-приложение и бота под ваш бизнес: запись к мастерам, каталог, заказ, оплата и уведомления. Смета по разделам, оплата по этапам после приёмки."
    />
    <NextCase current="/mini-app/" />
  </main>
</BaseLayout>

<script>
  import { initChatMirror } from '../../scripts/mini-app/chat-mirror';

  initChatMirror();
</script>
