---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CaseSpec from '../components/CaseSpec.astro';
import InfoSection from '../components/InfoSection.astro';
import CtaBox from '../components/CtaBox.astro';
import RaceLane from '../components/race/RaceLane.astro';
import '../styles/pages/speed-race.scss';

const weightSinks = [
  {
    title: 'Тема «всё включено»',
    text: 'Конструктор грузит стили и скрипты для всех 200 блоков темы, а вы используете шесть.',
  },
  {
    title: 'Слайдеры и счётчики',
    text: 'Три библиотеки анимации ради одной карусели, которую никто не листает дальше второго слайда.',
  },
  {
    title: 'Картинки без сжатия',
    text: 'Фото 4000×3000 из телефона, показанное в блоке 400×300. 3 МБ там, где хватило бы 80 КБ.',
  },
  {
    title: 'Пять семейств шрифтов',
    text: 'Заголовки, текст, кнопки, цитаты, всё разное, и каждое ждёт своей очереди. Отсюда мигание текста.',
  },
  {
    title: 'Прыжки макета',
    text: 'Баннер и куки-плашка приезжают позже контента и сдвигают его: вы целитесь в кнопку, а попадаете в рекламу.',
  },
  {
    title: 'Чем это лечится',
    text: 'Не «оптимизатором» из плагина, а ревизией: убрать неиспользуемое, сжать картинки, оставить один шрифт. Обычно минус 70% веса без потери вида.',
  },
];
---

<BaseLayout
  title="Гонка скорости: тяжёлый сайт против лёгкого"
  description="Две одинаковые страницы грузятся наперегонки: сборка на конструкторе против аккуратной вёрстки. Живые счётчики мегабайт, запросов и секунд."
  caseNav
>
  <main>
    <PageHeader kind="Ускорение загрузки">
      <Fragment slot="title">Два одинаковых сайта. Один вы закроете раньше, чем он загрузится</Fragment>
      <Fragment slot="lede">
        Слева типичная сборка на конструкторе: тема со «всем сразу», слайдеры, счётчики, пять
        шрифтов. Справа та же страница, собранная аккуратно. Нажмите и смотрите на счётчики.
      </Fragment>
      <button class="race-btn" type="button" data-race-start>Запустить гонку</button>
    </PageHeader>

    <div class="wrap">
      <div class="track">
        <RaceLane
          variant="heavy"
          title="Сборка «всё включено»"
          subtitle="тема + 24 плагина"
          ariaLabel="Тяжёлая сборка"
        />
        <RaceLane
          variant="light"
          title="Аккуратная сборка"
          subtitle="тот же макет, без лишнего"
          ariaLabel="Лёгкая сборка"
        />
      </div>
      <p class="finish" data-verdict></p>
      <p class="note">
        Симуляция: тайминги и объёмы типичные для страниц на перегруженных темах против
        аккуратной вёрстки при медленном 4G. Ваш реальный сайт замерю бесплатно, пришлите адрес.
      </p>
    </div>

    <CaseSpec
      task="Сайт на конструкторе открывается восемь секунд на телефоне, половина посетителей уходит до первого экрана. Переделывать с нуля дорого, а «плагин ускорения» ничего не меняет."
      solution="Ревизия вместо переезда: убрать неиспользуемые блоки темы, пережать картинки, оставить один шрифт, вынести тяжёлые скрипты из первого экрана. Макет и контент остаются прежними."
      result={[
        'Первый экран за полторы секунды вместо восьми',
        'Вес страницы меньше на 70% без потери вида',
        'Зелёная зона в Core Web Vitals, лучше позиции в поиске',
        'Отчёт до и после с цифрами, а не с обещаниями',
      ]}
      stack={['Аудит Lighthouse', 'Оптимизация картинок и шрифтов', 'TypeScript для симуляции', 'Astro для сборки']}
    />

    <InfoSection heading="Куда уходят мегабайты" items={weightSinks} />

    <CtaBox
      title="Сколько весит ваш сайт?"
      text="Замерю бесплатно и скажу честно: если у вас всё в порядке, так и напишу, работы не потребуется. Если нет, покажу три самых тяжёлых места и цену их лечения."
    />
  </main>
</BaseLayout>

<script>
  import { initSpeedRace } from '../scripts/speed-race';

  initSpeedRace();
</script>
