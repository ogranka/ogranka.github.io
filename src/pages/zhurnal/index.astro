---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CaseSpec from '../../components/CaseSpec.astro';
import InfoSection from '../../components/InfoSection.astro';
import CtaBox from '../../components/CtaBox.astro';
import { cities } from '../../data/zhurnal';
import '../../styles/pages/zhurnal-case.scss';

const how = [
  {
    title: 'Города как поддомены одной редакции',
    text: 'У каждого города своя главная, лента, рубрики и RSS, а тексты, авторы и шаблоны общие. В реальном запуске это поддомены вида город.издание, здесь они показаны папками.',
  },
  {
    title: 'Роли редакции и выпуск материалов',
    text: 'Статья это файл с заголовком, рубрикой, автором и датой. Автор пишет, редактор города ставит дату и отмечает материал дня, сборка публикует. Черновики без даты в выпуск не попадают.',
  },
  {
    title: 'Индексация по городам',
    text: 'На каждой странице свой заголовок, описание, канонический адрес и разметка Article и BreadcrumbList. Карта сайта и RSS собираются отдельно по городам, чтобы поиск видел два издания, а не одно.',
  },
  {
    title: 'Скорость на десяти тысячах материалов',
    text: 'Страницы собираются заранее и отдаются как файлы, без базы и сервера. Картинки сжимаются на сборке, шрифты лежат рядом, скрипта на странице статьи меньше двух килобайт.',
  },
  {
    title: 'Реклама и спецпроекты как тип материала',
    text: 'Партнёрский материал помечен в данных, а не вручную в тексте: пометка в карточке, блок партнёра в конце и отдельная разметка для поиска появляются сами.',
  },
];
---

<BaseLayout
  title="Городской журнал: онлайн-издание о жизни двух городов"
  description="Кейс онлайн-журнала о жизни города с двумя городами: лента, рубрики с пагинацией, статьи с оглавлением, авторы, поиск и SEO-слой как у настоящего СМИ."
  caseNav
>
  <main>
    <PageHeader kind="Онлайн-издание">
      <Fragment slot="title">Городской журнал, в котором два города живут в одной редакции</Fragment>
      <Fragment slot="lede">
        Онлайн-журнал о жизни города: материал дня, лента, рубрики, статьи с оглавлением, авторы и
        поиск. Два города переключаются в шапке, как поддомены одного издания. Ниже живая версия:
        читайте, переключайте город, ищите.
      </Fragment>
    </PageHeader>

    <div class="wrap">
      <div class="demo-frame">
        <iframe src={`/zhurnal/${cities[0].slug}/`} title={`Журнал, главная ${cities[0].genitive}`} loading="lazy"></iframe>
      </div>
      <p class="demo-open">
        Открыть отдельно:
        {cities.map((c, i) => <><a href={`/zhurnal/${c.slug}/`} target="_blank" rel="noopener">{c.name}</a>{i < cities.length - 1 && ', '}</>)}.
        Издание, города, авторы и тексты вымышленные, фото с Unsplash.
      </p>
    </div>

    <CaseSpec
      task="Редакции нужен сайт для издания, которое выходит в двух городах и собирается открывать третий: у каждого города свой адрес и своя лента, но одна команда, один дизайн и один набор правил для поиска."
      solution="Собрал издание на статической сборке с контентом в файлах: каждый город это папка со своей главной, рубриками, RSS и картой сайта, а шаблоны, авторы и типографика общие. Статьи со своим оглавлением, прогрессом чтения и разметкой для поисковиков, партнёрские материалы как отдельный тип."
      result={[
        'Новый город добавляется одной записью в справочнике, без переделки шаблонов',
        'Автор публикует материал файлом, без админки и без программиста',
        'Поиск видит каждый город как отдельное издание со своей картой сайта и RSS',
        'Страницы открываются мгновенно и не зависят от сервера и базы',
      ]}
      stack={['Astro, коллекции контента', 'Markdown', 'TypeScript', 'SCSS', 'JSON-LD, RSS, sitemap', 'Шрифты Literata и Geologica']}
    />

    <InfoSection heading="Как устроено" items={how} />

    <CtaBox
      title="Нужен сайт для издания, блога или базы знаний?"
      text="Соберу такую же редакционную систему под ваши рубрики и авторов: контент в файлах или в удобной админке, быстрые страницы, разметка для поиска. Смета по разделам, оплата по этапам после приёмки."
    />
  </main>
</BaseLayout>
